# Copy to .env for local dev. In production these come from Secret Manager.
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
DOCAI_PROCESSOR_ID=your-docai-processor-id
GEMINI_API_KEY=your-aistudio-key
SCHEDULER_TOKEN=generate-with-openssl-rand-hex-16
# Optional locally; deploy.sh generates one and registers it with setWebhook.
TELEGRAM_WEBHOOK_SECRET=
